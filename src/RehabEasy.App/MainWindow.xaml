<Window x:Class="RehabEasy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RehabEasy"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        Background="#F6F5F0">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="20"
                Background="#FFFDF8"
                BorderBrush="#DED8CB"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="7*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#343434"
                               Text="ID do paciente" />
                    <TextBox x:Name="PatientIdTextBox"
                             Grid.Row="2"
                             Padding="10"
                             FontSize="16"
                             MaxLength="40"
                             PreviewTextInput="PatientIdTextBox_OnPreviewTextInput" />
                    <TextBlock x:Name="StatusText"
                               Grid.Row="3"
                               Margin="0,10,0,0"
                               Foreground="#6F7B7A"
                               Text="Clique em Atualizar para buscar novos registros na API." />

                    <StackPanel Grid.Column="1"
                                Grid.Row="2"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="DeleteButton"
                                MinWidth="110"
                                Padding="14,9"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="DeleteButton_OnClick"
                                Content="Apagar" />
                        <Button x:Name="RefreshButton"
                                MinWidth="130"
                                Padding="14,9"
                                Click="RefreshButton_OnClick"
                                Content="Atualizar" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Padding="16"
                        Background="#F0ECE2"
                        BorderBrush="#DED8CB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#252525"
                                       Text="Registros recebidos" />
                            <ComboBox x:Name="DateSortComboBox"
                                      DockPanel.Dock="Right"
                                      MinWidth="180"
                                      Padding="8"
                                      SelectedIndex="0"
                                      SelectionChanged="DateSortComboBox_OnSelectionChanged">
                                <ComboBoxItem Content="Data decrescente" />
                                <ComboBoxItem Content="Data crescente" />
                            </ComboBox>
                        </DockPanel>

                        <ListBox x:Name="MessagesList"
                                 Grid.Row="2"
                                 BorderBrush="#D4CEC0"
                                 SelectionChanged="MessagesList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="#1F1F1F"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="12"
                                                       Foreground="#666666"
                                                       Text="{Binding Sender}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#5C5C5C"
                                                   Text="{Binding ReceivedAt, StringFormat={}{0:g}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Padding="18"
                        Background="#FFFFFF"
                        BorderBrush="#DED8CB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SubjectText"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1F1F1F"
                                   Text="Descricao dos testes realizados" />

                        <TextBlock x:Name="MetaText"
                                   Grid.Row="1"
                                   Margin="0,6,0,0"
                                   Foreground="#5C5C5C"
                                   Text="Selecione um registro para ver os testes informados." />

                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="BodyText"
                                       TextWrapping="Wrap"
                                       Foreground="#252525"
                                       Text="Os testes recebidos da API aparecerao aqui." />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="20"
                Background="#FFFFFF"
                BorderBrush="#DED8CB"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1F1F1F"
                               Text="Graficos dos dados" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#5C5C5C"
                               Text="Resumo visual dos dados importados." />
                </StackPanel>

                <Border Grid.Row="2"
                        Padding="18"
                        Background="#F7F4EC"
                        BorderBrush="#D8D1C3"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SummaryTitleText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#252525"
                                   Text="Resumo TUG" />

                        <Grid Grid.Row="1"
                              Margin="0,16,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="AverageTimeText"
                                           HorizontalAlignment="Center"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="#183A37"
                                           Text="--" />
                                <TextBlock x:Name="PrimaryMetricLabelText"
                                           HorizontalAlignment="Center"
                                           Foreground="#5C5C5C"
                                           Text="Tempo normal" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TestsCountText"
                                           HorizontalAlignment="Center"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="#183A37"
                                           Text="0" />
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="#5C5C5C"
                                           Text="Registros" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="RiskText"
                                           HorizontalAlignment="Center"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#B56A2A"
                                           Text="--" />
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="#5C5C5C"
                                           Text="Alerta" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="TugProgressBar"
                                     Grid.Row="2"
                                     Height="12"
                                     Maximum="20"
                                     Value="0" />
                        <TextBlock x:Name="PrimaryMetricReferenceText"
                                   Grid.Row="3"
                                   Margin="0,8,0,0"
                                   Foreground="#5C5C5C"
                                   Text="Referencia visual: 0 a 20 segundos" />
                        <TextBlock Grid.Row="4"
                                   Margin="0,12,0,0"
                                   Foreground="#777062"
                                   Text="Os indicadores sao atualizados com o registro selecionado." />
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Padding="18"
                        Background="#F3F7F5"
                        BorderBrush="#D1DCD8"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#252525"
                                   Text="Indicadores auxiliares" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DtcLabelText"
                                       VerticalAlignment="Center"
                                       Text="DTC pior" />
                            <ProgressBar x:Name="DtcProgressBar"
                                         Grid.Column="1"
                                         Height="10"
                                         Maximum="100"
                                         Value="0" />
                            <TextBlock x:Name="DtcText"
                                       Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Text="--" />
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SpeedLabelText"
                                       VerticalAlignment="Center"
                                       Text="Velocidade" />
                            <ProgressBar x:Name="SpeedProgressBar"
                                         Grid.Column="1"
                                         Height="10"
                                         Maximum="2"
                                         Value="0" />
                            <TextBlock x:Name="SpeedText"
                                       Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Text="--" />
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Status" />
                            <ProgressBar x:Name="StatusProgressBar"
                                         Grid.Column="1"
                                         Height="10"
                                         Maximum="100"
                                         Value="0" />
                            <TextBlock x:Name="StatusIndicatorText"
                                       Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Text="--" />
                        </Grid>

                        <TextBlock x:Name="ChartNotesText"
                                   Grid.Row="7"
                                   Margin="0,18,0,0"
                                   Foreground="#65756F"
                                   TextWrapping="Wrap"
                                   Text="Aguardando registros importados da API." />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
