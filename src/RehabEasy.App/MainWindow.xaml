<Window x:Class="RehabEasy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RehabEasy"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        FontFamily="Segoe UI"
        Background="{StaticResource MedBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Border Grid.Row="0"
                Padding="24,16"
                Background="{StaticResource MedPrimaryBrush}"
                BorderBrush="{StaticResource MedPrimaryDarkBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="RehabEasy" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="13"
                               Foreground="#CFE8EC"
                               Text="Prontuario clinico e indicadores de reabilitacao" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Background="#0A5561"
                        CornerRadius="20">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#E6F2F4"
                               Text="Ambiente clinico local" />
                </Border>
            </Grid>
        </Border>

        <!-- Layout principal: contexto | prontuario | graficos -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.4*" MinWidth="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Coluna 1: sidebar compacta -->
            <Border Style="{StaticResource MedCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Paciente: campo + acoes principais -->
                    <StackPanel>
                        <TextBlock Style="{StaticResource MedLabel}"
                                   Text="PACIENTE" />
                        <TextBox x:Name="PatientIdTextBox"
                                 Margin="0,6,0,0"
                                 Style="{StaticResource MedTextBox}"
                                 MaxLength="40"
                                 LostFocus="PatientIdTextBox_OnLostFocus"
                                 PreviewTextInput="PatientIdTextBox_OnPreviewTextInput" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RefreshButton"
                                    Style="{StaticResource MedButtonPrimary}"
                                    Margin="0"
                                    Click="RefreshButton_OnClick"
                                    Content="Atualizar" />
                            <Button x:Name="PatientActionsMenuButton"
                                    Grid.Column="1"
                                    MinWidth="42"
                                    Margin="8,0,0,0"
                                    Padding="10,10"
                                    Style="{StaticResource MedButtonSecondary}"
                                    Click="PatientActionsMenuButton_OnClick"
                                    Content="...">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="PatientActionsContextMenu_OnOpened">
                                        <MenuItem x:Name="DeleteMenuItem"
                                                  Header="Apagar registro selecionado"
                                                  Click="DeleteButton_OnClick" />
                                        <Separator />
                                        <MenuItem Header="Gerar relatorio de historico"
                                                  Click="GenerateHistoryReportButton_OnClick" />
                                        <MenuItem Header="Copiar historico completo"
                                                  Click="CopyHistoryReportButton_OnClick" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <Button x:Name="DeleteButton"
                                Visibility="Collapsed"
                                IsEnabled="False"
                                Click="DeleteButton_OnClick" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Grid.Row="2"
                               Style="{StaticResource MedCaption}"
                               Text="Clique em Atualizar para buscar novos registros." />

                    <!-- Navegacao por abas -->
                    <TabControl Grid.Row="4"
                                Style="{StaticResource MedSidebarTabControl}">
                        <TabItem Header="Registros"
                                 Style="{StaticResource MedSidebarTabItem}">
                            <Grid Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ComboBox x:Name="DateSortComboBox"
                                          HorizontalAlignment="Stretch"
                                          Padding="8,6"
                                          FontSize="12"
                                          SelectedIndex="0"
                                          SelectionChanged="DateSortComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Mais recente primeiro" />
                                    <ComboBoxItem Content="Mais antigo primeiro" />
                                </ComboBox>

                                <ListBox x:Name="MessagesList"
                                         Grid.Row="2"
                                         ItemContainerStyle="{StaticResource MedListBoxItem}"
                                         Style="{StaticResource MedListBox}"
                                         SelectionChanged="MessagesList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MedTextPrimaryBrush}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MedTextSecondaryBrush}"
                                                           Text="{Binding ReceivedAt, StringFormat={}{0:g}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Historico"
                                 Style="{StaticResource MedSidebarTabItem}">
                            <Grid Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="PatientHistorySummaryText"
                                           Style="{StaticResource MedCaption}"
                                           Text="Informe o ID do paciente para ver o historico." />

                                <ListBox x:Name="PatientTimelineList"
                                         Grid.Row="2"
                                         ItemContainerStyle="{StaticResource MedListBoxItem}"
                                         Style="{StaticResource MedListBox}"
                                         SelectionChanged="PatientTimelineList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Right"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MedPrimaryBrush}"
                                                               Text="{Binding Category}" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MedTextPrimaryBrush}"
                                                               Text="{Binding Headline}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MedTextSecondaryBrush}"
                                                           Text="{Binding Subline}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Exame"
                                 Visibility="Collapsed"
                                 Style="{StaticResource MedSidebarTabItem}">
                            <Grid Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="SubjectText"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MedTextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Nenhum registro selecionado" />
                                <TextBlock x:Name="MetaText"
                                           Grid.Row="2"
                                           Style="{StaticResource MedCaption}"
                                           Text="Selecione um registro na aba Registros." />

                                <ScrollViewer Grid.Row="4"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="BodyText"
                                               Style="{StaticResource MedBody}"
                                               FontSize="12"
                                               LineHeight="18"
                                               Text="Os dados do exame aparecem aqui." />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Coluna 2: PDF do exame (destaque principal) -->
            <Border Grid.Column="2"
                    Style="{StaticResource MedCard}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource MedPageTitle}"
                                   Text="PDF do exame" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource MedCaption}"
                                   Text="Documento original em destaque. Indicadores e prontuario ficam a direita." />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{StaticResource MedSurfaceBrush}"
                            BorderBrush="{StaticResource MedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <TextBlock x:Name="PdfPlaceholderText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MedCaption}"
                                       Text="Selecione um registro com PDF para visualizar." />
                            <wv2:WebView2 x:Name="PdfWebView"
                                         Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Coluna 3: indicadores + prontuario -->
            <Border Grid.Column="4"
                    Style="{StaticResource MedCard}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource MedPageTitle}"
                                   Text="Indicadores clinicos" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource MedCaption}"
                                   Text="Resumo visual do exame selecionado." />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Style="{StaticResource MedCardMuted}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="SummaryTitleText"
                                       Style="{StaticResource MedSectionTitle}"
                                       Text="Resumo TUG" />

                            <Grid Grid.Row="1"
                                  Margin="0,10,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <UniformGrid Rows="1">
                                    <Border Margin="0,0,4,0"
                                            Padding="8,12"
                                            Background="{StaticResource MedSurfaceBrush}"
                                            BorderBrush="{StaticResource MedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="AverageTimeText"
                                                       Style="{StaticResource MedMetricValue}"
                                                       FontSize="28"
                                                       Text="--" />
                                            <TextBlock x:Name="PrimaryMetricLabelText"
                                                       Style="{StaticResource MedMetricLabel}"
                                                       Text="Tempo normal" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="2,0"
                                            Padding="8,12"
                                            Background="{StaticResource MedSurfaceBrush}"
                                            BorderBrush="{StaticResource MedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="TestsCountText"
                                                       Style="{StaticResource MedMetricValue}"
                                                       FontSize="28"
                                                       Text="0" />
                                            <TextBlock Style="{StaticResource MedMetricLabel}"
                                                       Text="Registros" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4,0,0,0"
                                            Padding="8,12"
                                            Background="{StaticResource MedSurfaceBrush}"
                                            BorderBrush="{StaticResource MedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="RiskText"
                                                       HorizontalAlignment="Center"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource MedWarningBrush}"
                                                       Text="--" />
                                            <TextBlock Style="{StaticResource MedMetricLabel}"
                                                       Text="Alerta" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <ProgressBar x:Name="TugProgressBar"
                                             Grid.Row="2"
                                             Style="{StaticResource MedProgressBar}"
                                             Height="12"
                                             Maximum="20"
                                             Value="0" />
                            </Grid>

                            <TextBlock x:Name="PrimaryMetricReferenceText"
                                       Grid.Row="2"
                                       Style="{StaticResource MedCaption}"
                                       Text="Referencia visual: 0 a 20 segundos" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            Padding="14"
                            Background="#EEF6F3"
                            BorderBrush="#C8DDD4"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="160" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="ChartPanelTitleText"
                                           DockPanel.Dock="Left"
                                           Style="{StaticResource MedSectionTitle}"
                                           Text="Graficos do exame" />
                                <Border DockPanel.Dock="Right"
                                        Padding="8,3"
                                        CornerRadius="10"
                                        Background="{StaticResource MedSurfaceBrush}"
                                        BorderBrush="{StaticResource MedBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="StatusIndicatorText"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MedTextPrimaryBrush}"
                                               Text="--" />
                                </Border>
                            </DockPanel>

                            <Border Grid.Row="2"
                                    Background="{StaticResource MedSurfaceBrush}"
                                    BorderBrush="{StaticResource MedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,10,8,4">
                                <ItemsControl x:Name="MainChartBars">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="3,0"
                                                  ToolTip="{Binding Tooltip}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MedTextPrimaryBrush}"
                                                           Text="{Binding ValueLabel}" />
                                                <Border Grid.Row="1"
                                                        Margin="8,6,8,0"
                                                        VerticalAlignment="Bottom"
                                                        Height="{Binding BarHeight}"
                                                        MinHeight="4"
                                                        CornerRadius="7,7,2,2"
                                                        Background="{Binding Fill}" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,6,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource MedTextSecondaryBrush}"
                                                           Text="{Binding Label}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock x:Name="ChartLegendText"
                                       Grid.Row="4"
                                       Style="{StaticResource MedCaption}"
                                       FontSize="11"
                                       Text="Selecione um exame para ver os graficos." />

                            <TextBlock x:Name="ChartNotesText"
                                       Grid.Row="6"
                                       Style="{StaticResource MedCaption}"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       MaxHeight="64"
                                       Text="Aguardando registros importados da API." />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MedSectionTitle}"
                                       Text="Prontuario" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource MedCaption}"
                                       Text="Evolucao clinica do paciente selecionado." />
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right">
                            <Button x:Name="InsertExamDataButton"
                                    Visibility="Collapsed"
                                    Style="{StaticResource MedButtonSecondary}"
                                    MinWidth="140"
                                    Click="InsertExamDataButton_OnClick"
                                    Content="Inserir dados do exame" />
                            <Button x:Name="SaveClinicalNoteButton"
                                    Style="{StaticResource MedButtonPrimary}"
                                    MinWidth="90"
                                    Click="SaveClinicalNoteButton_OnClick"
                                    Content="Salvar" />
                            <Button x:Name="CopyClinicalNoteButton"
                                    Style="{StaticResource MedButtonAccent}"
                                    MinWidth="140"
                                    Margin="0"
                                    Click="CopyClinicalNoteButton_OnClick"
                                    Content="Copiar" />
                        </WrapPanel>
                    </Grid>

                    <TextBox x:Name="ClinicalNoteTextBox"
                             Grid.Row="8"
                             Padding="12,10"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontSize="14"
                             GotFocus="ClinicalNoteTextBox_OnGotFocus"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Background="{StaticResource MedSurfaceBrush}"
                             BorderBrush="{StaticResource MedBorderBrush}"
                             BorderThickness="1"
                             Foreground="{StaticResource MedTextPrimaryBrush}"
                             Text="Escreva aqui a evolucao clinica, conduta e observacoes do paciente." />

                    <TextBlock x:Name="ClinicalNoteStatusText"
                               Grid.Row="10"
                               Style="{StaticResource MedCaption}"
                               Text="Informe o ID do paciente para salvar o prontuario." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
