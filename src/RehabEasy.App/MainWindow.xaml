<Window x:Class="RehabEasy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RehabEasy"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        Background="#F4F1E8">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3"
                Padding="24"
                Background="#183A37"
                CornerRadius="24">
            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="Bold"
                               Foreground="#F7F3EB"
                               Text="RehabEasy" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#D7E3D4"
                               Text="Importacao via API e persistencia local dos dados recebidos." />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#D7E3D4"
                               Text="Cole o ID do payload, importe pela API e consulte os registros no RehabEasy." />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <TextBox x:Name="PayloadIdTextBox"
                             Width="330"
                             Height="38"
                             Margin="0,0,12,0"
                             Padding="10,8"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="RefreshButton"
                            MinWidth="140"
                            Padding="18,10"
                            Margin="0,0,12,0"
                            Click="RefreshButton_OnClick"
                            Content="Atualizar" />
                    <Button x:Name="ConnectButton"
                            MinWidth="180"
                            Padding="18,10"
                            Click="ConnectButton_OnClick"
                            Content="Importar payload" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="20"
                Background="#EFE7D8"
                CornerRadius="20">
            <DockPanel>
                <TextBox x:Name="SearchTextBox"
                         DockPanel.Dock="Top"
                         Margin="0,0,0,12"
                         Padding="10"
                         TextChanged="SearchTextBox_OnTextChanged" />

                <ListBox x:Name="MessagesList"
                         DisplayMemberPath="Title"
                         SelectionChanged="MessagesList_OnSelectionChanged" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Grid.Column="2"
                Padding="24"
                Background="#FFFDF8"
                CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SubjectText"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F1F1F"
                           Text="Selecione um registro" />

                <TextBlock x:Name="MetaText"
                           Grid.Row="1"
                           Margin="0,8,0,0"
                           Foreground="#5C5C5C"
                           Text="Os detalhes do registro aparecem aqui." />

                <TextBlock x:Name="StatusText"
                           Grid.Row="1"
                           Margin="0,32,0,0"
                           Foreground="#6F7B7A"
                           Text="Aguardando payload. Informe o ID gerado pela API para importar." />

                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="BodyText"
                               TextWrapping="Wrap"
                               Foreground="#252525"
                               Text="Os registros importados ficam gravados no SQLite local do RehabEasy." />
                </ScrollViewer>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Content="Exportar PDF"
                            IsEnabled="False" />
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Content="Exportar CSV"
                            IsEnabled="False" />
                    <Button Padding="14,8"
                            Content="Exportar JSON"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
